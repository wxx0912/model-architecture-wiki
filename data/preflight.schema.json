{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quantization Agent architecture preflight record",
  "oneOf": [
    {"$ref": "#/$defs/default"},
    {"$ref": "#/$defs/compact"}
  ],
  "$defs": {
    "default": {
    "type": "object",
    "required": ["schema_version", "profile_id", "knowledge_page", "model", "implementation", "runtime", "structure", "evidence", "checklist", "required_runtime_confirmation"],
    "properties": {
      "schema_version": {"const": 1},
      "profile_id": {"type": "string", "minLength": 1},
      "knowledge_page": {"type": "string", "minLength": 1},
      "model": {
        "type": "object",
        "required": ["name", "checkpoint", "model_type", "architectures"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "checkpoint": {"type": "string", "minLength": 1},
          "model_type": {"type": "string", "minLength": 1},
          "architectures": {"type": ["string", "array"], "items": {"type": "string"}, "minItems": 1, "minLength": 1},
          "num_hidden_layers": {"type": ["integer", "string"]},
          "hidden_size": {"type": ["integer", "string"]},
          "attention_layout": {"type": "string"},
          "moe_layout": {"type": "string"},
          "parameter_sharing": {"type": "array", "items": {"type": "string"}},
          "special_paths": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      },
      "implementation": {
        "type": "object",
        "required": ["repository", "revision"],
        "properties": {
          "repository": {"type": "string", "format": "uri"},
          "revision": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "runtime": {
        "type": "object",
        "required": ["source_revision", "device", "dtype", "input_signature"],
        "properties": {
          "source_revision": {"type": "string", "minLength": 1},
          "device": {"type": "string", "minLength": 1},
          "dtype": {"type": "string", "minLength": 1},
          "input_signature": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "structure": {
        "type": "object",
        "required": ["features", "num_hidden_layers", "hidden_size", "num_attention_heads", "num_key_value_heads", "num_experts", "num_experts_per_tok", "attention_layout", "moe_layout", "module_dependencies", "parameter_sharing", "special_paths", "tensor_flow"],
        "properties": {
          "features": {"type": "array", "items": {"type": "string"}},
          "num_hidden_layers": {"type": ["integer", "string"]},
          "hidden_size": {"type": ["integer", "string"]},
          "num_attention_heads": {"type": ["integer", "string"]},
          "num_key_value_heads": {"type": ["integer", "string"]},
          "num_experts": {"type": ["integer", "string"]},
          "num_experts_per_tok": {"type": ["integer", "string"]},
          "attention_layout": {"type": "string"},
          "moe_layout": {"type": "string"},
          "module_dependencies": {"type": ["string", "array"]},
          "parameter_sharing": {"type": "string"},
          "special_paths": {"type": "array", "items": {"type": "string"}},
          "tensor_flow": {"type": "string"}
        },
        "additionalProperties": false
      },
      "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
      "checklist": {"type": "array", "items": {"$ref": "#/$defs/check"}},
      "required_runtime_confirmation": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "compact": {
      "type": "object",
      "required": ["schema_version", "profile_id", "knowledge_page", "model", "implementation", "runtime", "structure", "evidence", "omitted_profile_evidence_count", "quantization_checks", "quantization_constraints", "runtime_gaps"],
      "properties": {
        "schema_version": {"const": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "knowledge_page": {"type": "string", "minLength": 1},
        "model": {"type": "object"},
        "implementation": {"type": "object"},
        "runtime": {"type": "object"},
        "structure": {"type": "object"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "omitted_profile_evidence_count": {"type": "integer", "minimum": 0},
        "quantization_checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "quantization_constraints": {
          "type": "object",
          "required": ["status", "quantizable_modules", "joint_quantization_groups", "excluded_modules", "supported_formats_and_kernels"],
          "properties": {
            "status": {"const": "not_assessed"},
            "quantizable_modules": {"const": "unknown"},
            "joint_quantization_groups": {"const": "unknown"},
            "excluded_modules": {"const": "unknown"},
            "supported_formats_and_kernels": {"const": "unknown"}
          },
          "additionalProperties": false
        },
        "runtime_gaps": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["claim", "classification", "source", "version_or_revision", "locator"],
      "properties": {
        "claim": {"type": "string"},
        "classification": {"enum": ["source-reported", "source-confirmed", "config-confirmed", "state-dict-confirmed", "forward-confirmed", "inferred", "unknown"]},
        "source": {"type": "string"},
        "version_or_revision": {"type": "string"},
        "locator": {"type": "string"}
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["feature", "pages", "potential_risk", "check_method", "validation_status"],
      "properties": {
        "feature": {"type": "string"},
        "potential_risk": {"type": "string"},
        "check_method": {"type": "string"},
        "pages": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "validation_status": {"const": "待核实"}
      },
      "additionalProperties": false
    }
  }
}
